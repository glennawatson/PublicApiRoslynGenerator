{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "description": "Keep .NET 10 package entries on 10.x.",
      "matchDatasources": ["nuget"],
      "matchPackageNames": [
        "/^Microsoft\\.Extensions\\./",
        "/^Microsoft\\.AspNetCore\\./",
        "/^Microsoft\\.NETCore\\./",
        "/^Microsoft\\.SourceLink\\./",
        "Microsoft.Build.Tasks.Git",
        "/^System\\./"
      ],
      "matchCurrentValue": "/^10\\./",
      "allowedVersions": "/^10\\./",
      "ignoreUnstable": true,
      "groupName": ".NET 10 packages",
      "groupSlug": "dotnet-10"
    },
    {
      "description": "Keep .NET 11 package entries on 11.x.",
      "matchDatasources": ["nuget"],
      "matchPackageNames": [
        "/^Microsoft\\.Extensions\\./",
        "/^Microsoft\\.AspNetCore\\./",
        "/^Microsoft\\.NETCore\\./",
        "/^Microsoft\\.SourceLink\\./",
        "Microsoft.Build.Tasks.Git",
        "/^System\\./"
      ],
      "matchCurrentValue": "/^11\\./",
      "allowedVersions": "/^11\\./",
      "ignoreUnstable": false,
      "groupName": ".NET 11 packages",
      "groupSlug": "dotnet-11"
    }
  ]
}
