<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>PublicApiSharp.Analyzers.Benchmarks</RootNamespace>

    <!-- Benchmark the newest slot: it renders the most constructs, so it is the slowest path. -->
    <MicrosoftCodeAnalysisVersion>5.6.0</MicrosoftCodeAnalysisVersion>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <!-- Match the slot to the Roslyn pinned above. Without this the benchmark measures the floor
         build, which is compiled against a different Roslyn and omits the newest slot's source
         entirely — so the constructs this project exists to measure are not in the binary. -->
    <ProjectReference Include="..\..\PublicApiSharp.Analyzers\PublicApiSharp.Analyzers.csproj"
                      AdditionalProperties="RoslynVersion=roslyn5.6" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="PublicApiSharp.Analyzers" />
  </ItemGroup>

</Project>
