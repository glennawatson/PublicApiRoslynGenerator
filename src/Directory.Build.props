<Project>

  <PropertyGroup>
    <CopyrightStartYear>2026</CopyrightStartYear>
    <CopyrightCurrentYear>$([System.DateTime]::UtcNow.ToString("yyyy"))</CopyrightCurrentYear>
    <CopyrightYearRange Condition="'$(CopyrightCurrentYear)' == '$(CopyrightStartYear)'">$(CopyrightStartYear)</CopyrightYearRange>
    <CopyrightYearRange Condition="'$(CopyrightCurrentYear)' != '$(CopyrightStartYear)'">$(CopyrightStartYear)-$(CopyrightCurrentYear)</CopyrightYearRange>
    <Copyright>Copyright (c) $(CopyrightYearRange) Glenn Watson and Contributors</Copyright>
    <Authors>Glenn Watson and Contributors</Authors>
    <Owners>glennawatson</Owners>
    <Company>Glenn Watson</Company>

    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/glennawatson/PublicApiRoslynGenerator</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>https://github.com/glennawatson/PublicApiRoslynGenerator/releases</PackageReleaseNotes>
    <!-- PackageTags are per-package: each *.Package project sets its own. -->
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RepositoryUrl>https://github.com/glennawatson/PublicApiRoslynGenerator</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <NeutralLanguage>en-US</NeutralLanguage>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DebugType>embedded</DebugType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>

    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <MinVerAutoIncrement>patch</MinVerAutoIncrement>
    <MinVerDefaultPreReleaseIdentifiers>alpha.0</MinVerDefaultPreReleaseIdentifiers>
    <MinVerMinimumMajorMinor>1.0</MinVerMinimumMajorMinor>

    <!-- Nothing packs by default. Only the .Package project opts back in with
         <IsPackable>true</IsPackable>; the analyzer/code-fix/test projects all
         stay non-packable so a `dotnet pack` of the solution produces exactly
         one .nupkg (PublicApiSharp.Analyzers). -->
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>

    <IsTestProject>$(MSBuildProjectName.Contains('Tests'))</IsTestProject>
  </PropertyGroup>

  <!--
    Multi-Roslyn targeting. The analyzer + code-fix assemblies are built once per
    Roslyn "slot" and packaged under analyzers/dotnet/<slot>/cs so the SDK loads
    the highest slot <= the host compiler's Roslyn version (CompilerApiVersion).
      roslyn4.8  = floor: .NET 8 SDK / VS 17.8 (C# 12), and .NET 9 (Roslyn 4.13).
      roslyn4.14 = .NET 10 SDK / VS 17.14 (C# 14).
      roslyn5.3  = .NET 11 line (C# 15: extension blocks round-trip here).
      roslyn5.6  = current Roslyn: adds union syntax (SyntaxKind.UnionDeclaration).
    Pick a slot with -p:RoslynVersion=roslyn5.3; the default below is the floor.

    The slot matters more here than in a normal analyzer: the API surface this
    package renders comes from Roslyn's own symbol model, so a newer slot renders
    newer language constructs for free. A construct can only appear in source that
    the host compiler could parse, so a project that builds on the 4.8 floor cannot
    contain C# 15 syntax and renders identically on every slot — which is what keeps
    a baseline stable across a mixed dev/CI SDK estate.
  -->
  <PropertyGroup>
    <IsRoslynComponentProject Condition="'$(MSBuildProjectName)' == 'PublicApiSharp.Analyzers' Or '$(MSBuildProjectName)' == 'PublicApiSharp.Analyzers.CodeFixes'">true</IsRoslynComponentProject>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsRoslynComponentProject)' == 'true'">
    <!-- Segregate per-slot output AND intermediates so building several slots in
         one invocation (e.g. during pack) doesn't share obj/ — otherwise one
         slot's compiled constants leak into another's reference set.

         The folder keys off the slot as *requested*, before the default below is
         applied. MSBuild identifies a project by its global properties, so a build
         with no RoslynVersion is a different node from one with
         -p:RoslynVersion=roslyn4.8 even though both resolve to the floor. Two nodes
         are scheduled in parallel, so sharing a folder makes them race for the same
         output file (CS2012 on Windows, a locked deps.json elsewhere). One folder
         per node is what keeps that from happening. -->
    <RoslynSlotOutputName>$(RoslynVersion)</RoslynSlotOutputName>
    <RoslynSlotOutputName Condition="'$(RoslynSlotOutputName)' == ''">default</RoslynSlotOutputName>
    <BaseOutputPath>bin/$(RoslynSlotOutputName)/</BaseOutputPath>
    <BaseIntermediateOutputPath>obj/$(RoslynSlotOutputName)/</BaseIntermediateOutputPath>

    <RoslynVersion Condition="'$(RoslynVersion)' == ''">roslyn4.8</RoslynVersion>
    <!-- The default item globs only exclude the *current* slot's bin/obj; exclude
         every slot's so a build doesn't pull a sibling slot's generated
         AssemblyInfo.cs (CS0579 duplicate attributes). -->
    <DefaultItemExcludes>$(DefaultItemExcludes);$(MSBuildProjectDirectory)/obj/**;$(MSBuildProjectDirectory)/bin/**</DefaultItemExcludes>
  </PropertyGroup>

  <!--
    Slot-specific code lives in its own file rather than behind #if, and only the file matching this
    build's capabilities is compiled. Two things fall out of that. The code reads without
    conditionals, and — because a variant file appears in exactly one slot's coverage report — a
    coverage tool merging all four reports sees each file fully covered instead of crediting hits
    from one slot against lines that only exist in another.

    The tier is named for the lowest slot that has its capabilities, so roslyn5.6 compiles the
    Roslyn53 files: nothing changed between them.
  -->
  <PropertyGroup Condition="'$(IsRoslynComponentProject)' == 'true'">
    <RoslynSourceTier Condition="'$(RoslynVersion)' == 'roslyn4.8'">Roslyn48</RoslynSourceTier>
    <RoslynSourceTier Condition="'$(RoslynVersion)' == 'roslyn4.14'">Roslyn414</RoslynSourceTier>
    <RoslynSourceTier Condition="'$(RoslynSourceTier)' == ''">Roslyn53</RoslynSourceTier>

    <!-- Keep every variant out of the SDK's default glob, which is applied after this file, then
         add back only the tier this build wants. Removing them in an ItemGroup here would run
         before the glob and leave the file included twice (NETSDK1022). -->
    <DefaultItemExcludes>$(DefaultItemExcludes);**/*.Roslyn48.cs;**/*.Roslyn414.cs;**/*.Roslyn53.cs</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsRoslynComponentProject)' == 'true'">
    <Compile Include="**/*.$(RoslynSourceTier).cs" Exclude="$(BaseOutputPath)/**;$(BaseIntermediateOutputPath)/**" />
  </ItemGroup>

  <PropertyGroup Condition="'$(IsRoslynComponentProject)' == 'true' And '$(RoslynVersion)' == 'roslyn4.8'">
    <MicrosoftCodeAnalysisVersion>4.8.0</MicrosoftCodeAnalysisVersion>
    <DefineConstants>$(DefineConstants);ROSLYN_4_8_OR_GREATER</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsRoslynComponentProject)' == 'true' And '$(RoslynVersion)' == 'roslyn4.14'">
    <MicrosoftCodeAnalysisVersion>4.14.0</MicrosoftCodeAnalysisVersion>
    <DefineConstants>$(DefineConstants);ROSLYN_4_8_OR_GREATER;ROSLYN_4_14_OR_GREATER</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsRoslynComponentProject)' == 'true' And '$(RoslynVersion)' == 'roslyn5.3'">
    <MicrosoftCodeAnalysisVersion>5.3.0</MicrosoftCodeAnalysisVersion>
    <DefineConstants>$(DefineConstants);ROSLYN_4_8_OR_GREATER;ROSLYN_4_14_OR_GREATER;ROSLYN_5_OR_GREATER</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsRoslynComponentProject)' == 'true' And '$(RoslynVersion)' == 'roslyn5.6'">
    <MicrosoftCodeAnalysisVersion>5.6.0</MicrosoftCodeAnalysisVersion>
    <DefineConstants>$(DefineConstants);ROSLYN_4_8_OR_GREATER;ROSLYN_4_14_OR_GREATER;ROSLYN_5_OR_GREATER;ROSLYN_5_6_OR_GREATER</DefineConstants>
  </PropertyGroup>

  <!-- Non-component projects (tests, benchmarks, package) pin Roslyn here. This
       value drives the central Microsoft.CodeAnalysis.* versions in
       Directory.Packages.props, so per-slot builds stay internally consistent
       under central transitive pinning. -->
  <PropertyGroup>
    <MicrosoftCodeAnalysisVersion Condition="'$(MicrosoftCodeAnalysisVersion)' == ''">5.6.0</MicrosoftCodeAnalysisVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
    <OutputType>Exe</OutputType>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <TUnitImplicitUsings>true</TUnitImplicitUsings>
    <TUnitAssertionsImplicitUsings>true</TUnitAssertionsImplicitUsings>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <PackageReference Include="TUnit" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <!-- Shared Microsoft.Testing.Platform code-coverage settings (exclusions for
         generated code etc); copied next to each test assembly as
         AssemblyName.testconfig.json so the test runner's coverage step uses it. -->
    <None Include="$(MSBuildThisFileDirectory)testconfig.json" Condition="Exists('$(MSBuildThisFileDirectory)testconfig.json')">
      <Link>$(AssemblyName).testconfig.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\LICENSE" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)..\README.md" Pack="true" PackagePath="\" Visible="false" Condition="Exists('$(MSBuildThisFileDirectory)..\README.md')" />
    <None Include="$(MSBuildThisFileDirectory)..\assets\icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="all" />
    <PackageReference Include="StyleSharp.Analyzers" PrivateAssets="all" />
    <PackageReference Include="PerformanceSharp.Analyzers" PrivateAssets="all" />
    <PackageReference Include="SecuritySharp.Analyzers" PrivateAssets="all" />
    <PackageReference Include="Roslynator.Analyzers" PrivateAssets="all" />
    <PackageReference Include="SonarAnalyzer.CSharp" PrivateAssets="all" />
  </ItemGroup>

  <!--
    The .NET SDK + transitive packages auto-load several source generators that
    have nothing to do in this codebase. Each one still scans the full compilation
    looking for its trigger attribute, so removing them from @(Analyzer) before
    CoreCompile shaves real csc time. Audited usage (re-check before re-enabling):
      ComInterfaceGenerator       — no [GeneratedComInterface]
      ComClassGenerator           — no [GeneratedComClass]
      VtableIndexStubGenerator    — COM vtable, unused
      JSImportGenerator           — no Blazor WASM JS interop
      LibraryImportGenerator      — no [LibraryImport]/[DllImport]
      System.Text.Json.SourceGeneration
                                  — no JsonSerializable contexts
    Re-enable any of these the moment the corresponding attribute is introduced;
    csc will silently produce wrong output otherwise.
  -->
  <Target Name="RemoveUnusedSdkGenerators" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)"
                Condition="'%(Filename)' == 'Microsoft.Interop.ComInterfaceGenerator'
                        or '%(Filename)' == 'Microsoft.Interop.ComClassGenerator'
                        or '%(Filename)' == 'Microsoft.Interop.VtableIndexStubGenerator'
                        or '%(Filename)' == 'Microsoft.Interop.JavaScript.JSImportGenerator'
                        or '%(Filename)' == 'Microsoft.Interop.LibraryImportGenerator'
                        or '%(Filename)' == 'System.Text.Json.SourceGeneration'" />
    </ItemGroup>
  </Target>
</Project>
