<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <!-- The only packable project in the repo (see Directory.Build.props);
         everything else is non-packable so a `dotnet pack` of the solution produces
         exactly one .nupkg. -->
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>PublicApiSharp.Analyzers</PackageId>
    <PackageTags>analyzers;roslyn;codefix;publicapi;api;api-approval;breaking-changes;semver</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <DevelopmentDependency>true</DevelopmentDependency>
    <NoPackageAnalysis>true</NoPackageAnalysis>
    <!-- Analyzer-only package: no lib/ folder, so the empty dependency group is expected. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>

    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_AddAnalyzersToOutput</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <!-- Roslyn slots shipped under analyzers/dotnet/<slot>/cs. The SDK (>= 6.0.100) loads
       the highest slot <= the host compiler's Roslyn version. Keep in sync with the slot
       definitions in Directory.Build.props.

       The reference list below repeats the slots because AdditionalProperties has to be
       literal: item metadata cannot be batched outside a target, so the references cannot
       be generated from the property. Adding a slot means adding both.

       They have to be real references rather than a nested `dotnet build`, so that MSBuild
       owns the scheduling. The test projects reference the same instances, and only an
       in-graph reference lets MSBuild recognise the two as one build and run it once; a
       spawned process is invisible to it and races for the same output files instead.

       ReferenceOutputAssembly is off because this project ships the assemblies as content
       rather than compiling against them — four builds of one assembly identity could not
       all be referenced anyway. -->
  <PropertyGroup>
    <RoslynSlots>roslyn4.8;roslyn4.14;roslyn5.3;roslyn5.6</RoslynSlots>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PublicApiSharp.Analyzers.CodeFixes\PublicApiSharp.Analyzers.CodeFixes.csproj"
                      AdditionalProperties="RoslynVersion=roslyn4.8"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\PublicApiSharp.Analyzers.CodeFixes\PublicApiSharp.Analyzers.CodeFixes.csproj"
                      AdditionalProperties="RoslynVersion=roslyn4.14"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\PublicApiSharp.Analyzers.CodeFixes\PublicApiSharp.Analyzers.CodeFixes.csproj"
                      AdditionalProperties="RoslynVersion=roslyn5.3"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\PublicApiSharp.Analyzers.CodeFixes\PublicApiSharp.Analyzers.CodeFixes.csproj"
                      AdditionalProperties="RoslynVersion=roslyn5.6"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- The consumer-side MSBuild logic: discovers the per-TFM baseline file and adds
       it to @(AdditionalFiles) so the analyzer can see it. Auto-imported by NuGet
       because it is named <PackageId>.props under build/. -->
  <ItemGroup>
    <None Include="build\PublicApiSharp.Analyzers.props" Pack="true" PackagePath="build\" />
    <None Include="build\PublicApiSharp.Analyzers.targets" Pack="true" PackagePath="build\" />
  </ItemGroup>

  <!-- Collect the per-slot assemblies the references above have already built. -->
  <Target Name="_AddAnalyzersToOutput">
    <ItemGroup>
      <_RoslynSlot Include="$(RoslynSlots)" />
      <TfmSpecificPackageFile Include="..\PublicApiSharp.Analyzers\bin\%(_RoslynSlot.Identity)\$(Configuration)\netstandard2.0\PublicApiSharp.Analyzers.dll"
                              PackagePath="analyzers/dotnet/%(_RoslynSlot.Identity)/cs" />
      <TfmSpecificPackageFile Include="..\PublicApiSharp.Analyzers.CodeFixes\bin\%(_RoslynSlot.Identity)\$(Configuration)\netstandard2.0\PublicApiSharp.Analyzers.CodeFixes.dll"
                              PackagePath="analyzers/dotnet/%(_RoslynSlot.Identity)/cs" />
    </ItemGroup>
  </Target>

</Project>
