<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- Avoid NuGet ID conflicts with the .Package project, which owns the published id. -->
    <PackageId>*$(MSBuildProjectFile)*</PackageId>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PublicApiSharp.Analyzers.CodeFixes" />
    <InternalsVisibleTo Include="PublicApiSharp.Analyzers.Benchmarks" />
    <InternalsVisibleTo Include="PublicApiSharp.Analyzers.Tests.Roslyn48" />
    <InternalsVisibleTo Include="PublicApiSharp.Analyzers.Tests.Roslyn414" />
    <InternalsVisibleTo Include="PublicApiSharp.Analyzers.Tests.Roslyn53" />
    <InternalsVisibleTo Include="PublicApiSharp.Analyzers.Tests.Roslyn56" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Linq" />
    <Using Include="System.Collections.Immutable" />
    <Using Include="System.Diagnostics.CodeAnalysis" />
    <Using Include="Microsoft.CodeAnalysis" />
    <Using Include="Microsoft.CodeAnalysis.CSharp" />
    <Using Include="Microsoft.CodeAnalysis.CSharp.Syntax" />
    <Using Include="Microsoft.CodeAnalysis.Diagnostics" />
    <Using Include="Microsoft.CodeAnalysis.Text" />
    <Using Include="RoslynCommon.Analyzers" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\Analyzers\*.cs"
             Exclude="..\Shared\Analyzers\*.Roslyn48.cs;..\Shared\Analyzers\*.Roslyn414.cs;..\Shared\Analyzers\*.Roslyn53.cs"
             Link="Helpers\Shared\%(Filename).cs" />
    <Compile Include="..\Shared\Analyzers\*.$(RoslynSourceTier).cs" Link="Helpers\Shared\%(Filename).cs" />
  </ItemGroup>

</Project>
