<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PublicApiSharp.Analyzers.Tests</RootNamespace>

    <!-- Run the tests against the newest Roslyn the package ships a slot for, so the test compiler
         can parse the latest C# syntax the renderer is expected to describe. The analyzer source is
         version-agnostic (netstandard2.0), so this exercises the same logic. -->
    <MicrosoftCodeAnalysisVersion>5.6.0</MicrosoftCodeAnalysisVersion>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.CodeFix.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\PublicApiSharp.Analyzers.CodeFixes\PublicApiSharp.Analyzers.CodeFixes.csproj" />
    <ProjectReference Include="..\..\PublicApiSharp.Analyzers\PublicApiSharp.Analyzers.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="PublicApiSharp.Analyzers" />
    <Using Include="RoslynCommon.Analyzers" />
  </ItemGroup>

</Project>
